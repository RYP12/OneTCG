{% extends 'base.html.twig' %}

{% block title %}
	{{ carta.nombre }}
	- One Piece TCG
{% endblock %}

{% block body %}
	<div class="container py-5">
		<div
			class="row">
			{# Columna Izquierda: Imagen #}
			<div class="col-md-5 mb-4 mb-md-0">
				<div class="card bg-transparent border-0">
					{% if carta.imagenes is not empty %}
						<img src="{{ carta.imagenes.first.url }}" class="img-fluid rounded shadow-lg" alt="{{ carta.nombre }}">
					{% else %}
						<div class="ratio ratio-3x4 bg-secondary rounded d-flex align-items-center justify-content-center">
							<span class="text-white fs-1">?</span>
						</div>
					{% endif %}
				</div>
			</div>

			{# Columna Derecha: Detalles #}
			<div class="col-md-7">
				<div class="d-flex justify-content-between align-items-start mb-3">
					<div>
						<h1 class="display-4 fw-bold text-white mb-0">{{ carta.nombre }}</h1>
						<p class="h4 text-warning font-monospace">{{ carta.id }}</p>
					</div>

					{# Badges de Atributos #}
					<div class="text-end">
						<span class="badge bg-danger fs-6 mb-1">{{ carta.color }}</span>
						{% if carta.rarity %}
							<span class="badge bg-warning text-dark fs-6 mb-1">{{ carta.rarity }}</span>
						{% endif %}
					</div>
				</div>

				<hr
				class="border-secondary">

				{# Grid de Estadísticas #}
				<div class="row text-center mb-4 g-2">
					<div class="col-3">
						<div class="p-2 border border-secondary rounded bg-dark h-100">
							<small class="text-uppercase text-muted d-block">Coste</small>
							<span class="fs-4 fw-bold text-white">{{ carta.coste ?? '-' }}</span>
						</div>
					</div>
					<div class="col-3">
						<div class="p-2 border border-secondary rounded bg-dark h-100">
							<small class="text-uppercase text-muted d-block">Poder</small>
							<span class="fs-4 fw-bold text-white">{{ carta.poder ?? '-' }}</span>
						</div>
					</div>
					<div class="col-3">
						<div class="p-2 border border-secondary rounded bg-dark h-100">
							<small class="text-uppercase text-muted d-block">Counter</small>
							<span class="fs-4 fw-bold text-white">{{ carta.counter ?? '-' }}</span>
						</div>
					</div>
					<div class="col-3">
						<div class="p-2 border border-secondary rounded bg-dark h-100">
							<small class="text-uppercase text-muted d-block">Tipo</small>
							<span class="fs-6 fw-bold text-white text-truncate" title="{{ carta.tipo }}">{{ carta.tipo ?? '-' }}</span>
						</div>
					</div>
				</div>

				{# Caja de Texto #}
				<div class="card bg-dark border-secondary mb-4">
					<div class="card-body">
						{% if carta.habilidad %}
							<h5 class="text-warning mb-2">Efecto</h5>
							<p class="card-text text-light" style="white-space: pre-wrap;">{{ carta.habilidad }}</p>
						{% endif %}

						{% if carta.efectoTrigger %}
							<hr class="border-secondary my-3">
							<h6 class="text-warning mb-2 text-uppercase badge bg-warning text-dark">Trigger</h6>
							<p class="card-text text-light fst-italic">{{ carta.efectoTrigger }}</p>
						{% endif %}

						{% if not carta.habilidad and not carta.efectoTrigger %}
							<p class="text-muted fst-italic">Sin efectos.</p>
						{% endif %}
					</div>
				</div>

				{# Botones de Acción #}
				<div class="d-grid gap-2 d-md-block mb-4">
					{% if app.user %}
						<button class="btn btn-warning btn-lg px-5 fw-bold text-dark shadow-sm">
							⭐ Añadir a mi colección
						</button>
					{% else %}
						<a href="{{ path('app_login') }}" class="btn btn-outline-secondary btn-lg px-5" data-bs-toggle="tooltip" data-bs-placement="top" title="Inicia sesión para añadir a tu colección">
							🔒 Inicia sesión para añadir
						</a>
					{% endif %}
					<a href="{{ path('app_home') }}" class="btn btn-outline-light btn-lg">Volver</a>
				</div>

				<div class="mb-4">
					<small class="text-muted">Expansión:
						<span class="text-light">{{ carta.expansion ? carta.expansion.nombreExpansion : 'Desconocida' }}</span>
					</small>
				</div>

				{# Sección de Valoraciones #}
				<div class="mt-5">
					<h3 class="border-bottom border-secondary pb-2 mb-4">Valoraciones de la Comunidad</h3>

					{% if resenyas is not empty %}
						{% for resenya in resenyas %}
							<div class="card bg-dark border-secondary mb-3">
								<div class="card-body">
									<div class="d-flex justify-content-between align-items-center mb-2">
										<h5 class="card-title text-warning mb-0">{{ resenya.usuario.username }}</h5>
										<span class="badge bg-warning text-dark fs-6">★
											{{ resenya.puntuacion }}</span>
									</div>
									{% if resenya.comentario %}
										<p class="card-text text-light">"{{ resenya.comentario }}"</p>
									{% endif %}
								</div>
							</div>
						{% endfor %}
					{% else %}
						<div class="alert alert-dark text-center" role="alert">
							No hay valoraciones aún. ¡Sé el primero en opinar!
						</div>
					{% endif %}

					{% if app.user %}
						<div class="mt-4 text-end">
							<button class="btn btn-outline-warning">
								✎ Escribir una valoración
							</button>
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
{% endblock %}
