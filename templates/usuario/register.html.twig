{% extends 'base.html.twig' %}

{% block title %}Crear Cuenta - OneTCG
{% endblock %}

{% block body %}
	<div class="auth-wrapper">
		<div class="auth-card">

			<div class="auth-header">
				<span class="auth-icon">🏴‍☠️</span>
				<h1>Crear Cuenta</h1>
			</div>

			<form method="post">
				<div class="auth-group">
					<label for="username">Nombre de usuario</label>
					<div class="auth-input-wrap">
						<input type="text" id="username" name="username" class="auth-input" placeholder="Ej. LuffyReyPirata" required autofocus>
						<span class="auth-input-icon">🧑‍✈️</span>
					</div>
				</div>

				<div class="auth-group">
					<label for="email">Correo electrónico</label>
					<div class="auth-input-wrap">
						<input type="email" id="email" name="email" class="auth-input" placeholder="nombre@email.com" required>
						<span class="auth-input-icon">✉️</span>
					</div>
				</div>

				<div class="auth-group">
					<label for="password">Contraseña</label>
					<div class="auth-input-wrap">
						<input type="password" id="password" name="password" class="auth-input" placeholder="Mínimo 6 caracteres" required>
						<span class="auth-input-icon">🔒</span>
					</div>
					<div class="auth-hint">La contraseña debe tener al menos 6 caracteres.</div>
				</div>

				<button class="auth-btn" type="submit">Registrarse</button>
			</form>

			<div class="auth-footer">
				¿Ya tienes una cuenta?
				<a href="{{ path('app_login') }}">Inicia sesión aquí</a>
			</div>

		</div>
	</div>
{% endblock %}
