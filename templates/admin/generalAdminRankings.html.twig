{% extends 'base.html.twig' %}

{% block title %}Gestión de Tierlists - Admin
{% endblock %}

{% block body %}
	<div class="container py-5">
		<h1 class="display-5 fw-bold text-warning mb-4">🏆 Gestión de Tierlists (Rankings)</h1>

		{# SECCIÓN: Formulario para crear Ranking #}
		<div class="card bg-dark border-secondary mb-5">
			<div class="card-body">
				<h4 class="text-light mb-3">Crear nueva Tierlist</h4>
				<form method="POST" action="{{ path('admin_rankings') }}" class="d-flex gap-3 align-items-end">
					<div class="flex-grow-1">
						<label for="nombre" class="form-label text-muted">Nombre de la Tierlist</label>
						<input type="text" name="nombre" id="nombre" class="form-control bg-dark text-light border-secondary" placeholder="Ej: Mejores Líderes OP05, Top Atacantes..." required>
					</div>
					<button type="submit" class="btn btn-warning fw-bold text-dark px-4">
						✚ Crear Tierlist
					</button>
				</form>
			</div>
		</div>

		{# SECCIÓN: Listado de Rankings #}
		<h3 class="text-light mb-3">Tierlists Globales Creadas</h3>

		{% if rankings is not empty %}
			<div class="table-responsive">
				<table class="table table-dark table-hover border-secondary align-middle">
					<thead>
						<tr>
							<th class="text-warning">#</th>
							<th class="text-warning">Nombre</th>
							<th class="text-warning text-center">Cartas Asignadas</th>
							<th class="text-warning text-end">Acciones</th>
						</tr>
					</thead>
					<tbody>
						{% for ranking in rankings %}
							<tr>
								<td>{{ ranking.id }}</td>
								<td class="fw-bold">{{ ranking.nombre }}</td>

								<td class="text-center">
									<span class="badge bg-info fs-6">{{ ranking.cartasDisponibles|length }}
										cartas</span>
								</td>

								<td class="text-end">
									<a href="{{ path('admin_ranking_editar', {'id': ranking.id}) }}" class="btn btn-sm btn-outline-info me-2">
										⚙️ Gestionar Cartas
									</a>
									<a href="{{ path('admin_ranking_eliminar', {'id': ranking.id}) }}" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Estás seguro de eliminar este ranking? Se perderán las listas de todos los usuarios.')">
										🗑 Eliminar
									</a>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% else %}
			<div class="alert alert-dark border-secondary text-center text-light">
				No hay Tierlists creadas todavía. ¡Crea la primera usando el formulario de arriba!
			</div>
		{% endif %}

		<a href="{{ path('app_home') }}" class="btn btn-outline-light mt-3">🔙 Volver al inicio</a>
	</div>
{% endblock %}
