{% extends 'base.html.twig' %}

{% block title %}Panel de Administración - OneTCG{% endblock %}

{% block body %}
<div class="container py-5">

    {# SECCIÓN: Cabecera #}
    <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom border-secondary">
        <div>
            <h1 class="display-5 fw-bold text-warning mb-1">👨‍💻 Panel de Administración</h1>
            <p class="text-secondary mb-0">Gestión global del sitio One Piece TCG</p>
        </div>
        <span class="badge bg-warning text-dark fs-6 px-3 py-2">ADMIN</span>
    </div>

    {# SECCIÓN: Mensaje de estado (tras cargar API) #}
    {% if message is defined %}
        <div class="alert {% if status == 'success' %}alert-success{% else %}alert-danger{% endif %} border-0 mb-4">
            {{ message }}
        </div>
    {% endif %}

    {# SECCIÓN: Tarjetas de Estadísticas #}
    <h4 class="text-secondary text-uppercase mb-3" style="font-size: 0.8rem; letter-spacing: 2px;">Resumen Global</h4>
    <div class="row g-4 mb-5">

        <div class="col-6 col-md-4 col-lg">
            <div class="card bg-dark border-secondary h-100 text-center p-3">
                <div class="display-4 fw-bold text-warning">{{ total_cartas }}</div>
                <div class="text-secondary small text-uppercase mt-1">Cartas</div>
                <a href="{{ path('admin_cartas_list') }}" class="stretched-link"></a>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg">
            <div class="card bg-dark border-secondary h-100 text-center p-3">
                <div class="display-4 fw-bold text-info">{{ total_expansiones }}</div>
                <div class="text-secondary small text-uppercase mt-1">Expansiones</div>
                <a href="{{ path('admin_expansiones') }}" class="stretched-link"></a>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg">
            <div class="card bg-dark border-secondary h-100 text-center p-3">
                <div class="display-4 fw-bold text-success">{{ total_usuarios }}</div>
                <div class="text-secondary small text-uppercase mt-1">Usuarios</div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg">
            <div class="card bg-dark border-secondary h-100 text-center p-3">
                <div class="display-4 fw-bold text-primary">{{ total_rankings }}</div>
                <div class="text-secondary small text-uppercase mt-1">Rankings</div>
                <a href="{{ path('admin_rankings') }}" class="stretched-link"></a>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg">
            <div class="card bg-dark border-secondary h-100 text-center p-3">
                <div class="display-4 fw-bold text-danger">{{ total_resenyas }}</div>
                <div class="text-secondary small text-uppercase mt-1">Reseñas</div>
            </div>
        </div>

    </div>

    {# SECCIÓN: Estadísticas Detalladas #}
    <h4 class="text-secondary text-uppercase mb-3" style="font-size: 0.8rem; letter-spacing: 2px;">Estadísticas Detalladas</h4>
    <div class="row g-4 mb-5">

        {# Lista de Usuarios #}
        <div class="col-12 col-lg-4">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-white text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">Usuarios</span>
                    <span class="badge bg-success">{{ lista_usuarios|length }}</span>
                </div>
                <div class="card-body p-0" style="max-height: 320px; overflow-y: auto;">
                    {% if lista_usuarios is empty %}
                        <p class="text-secondary fst-italic p-3 mb-0">Sin usuarios registrados.</p>
                    {% else %}
                        <table class="table table-dark table-sm align-middle mb-0">
                            <thead style="position: sticky; top: 0; background-color: #1a1a1a;">
                                <tr class="border-secondary" style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; color: rgba(255,255,255,0.4);">
                                    <th class="ps-3">Usuario</th>
                                    <th>Email</th>
                                    <th class="text-center">Rol</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for usuario in lista_usuarios %}
                                    <tr>
                                        <td class="ps-3 fw-bold text-white">{{ usuario.username }}</td>
                                        <td class="text-secondary" style="font-size: 0.8rem;">{{ usuario.email }}</td>
                                        <td class="text-center">
                                            {% if 'ROLE_ADMIN' in usuario.roles %}
                                                <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">Admin</span>
                                            {% else %}
                                                <span class="badge bg-secondary" style="font-size: 0.65rem;">Usuario</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Lista de Rankings #}
        <div class="col-12 col-lg-4">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-white text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">Rankings</span>
                    <span class="badge bg-primary">{{ lista_rankings|length }}</span>
                </div>
                <div class="card-body p-0" style="max-height: 320px; overflow-y: auto;">
                    {% if lista_rankings is empty %}
                        <p class="text-secondary fst-italic p-3 mb-0">Sin rankings creados.</p>
                    {% else %}
                        <table class="table table-dark table-sm align-middle mb-0">
                            <thead style="position: sticky; top: 0; background-color: #1a1a1a;">
                                <tr class="border-secondary" style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; color: rgba(255,255,255,0.4);">
                                    <th class="ps-3">Nombre</th>
                                    <th class="text-center">Cartas</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for ranking in lista_rankings %}
                                    <tr>
                                        <td class="ps-3 fw-bold text-white">
                                            <a href="{{ path('admin_ranking_editar', {'id': ranking.id}) }}" class="text-white text-decoration-none">
                                                {{ ranking.nombre }}
                                            </a>
                                        </td>
                                        <td class="text-center text-secondary">{{ ranking.cartasDisponibles|length }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Valoraciones Recientes #}
        <div class="col-12 col-lg-4">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-white text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">Valoraciones Recientes</span>
                    <span class="badge bg-danger">{{ total_resenyas }}</span>
                </div>
                <div class="card-body p-0" style="max-height: 320px; overflow-y: auto;">
                    {% if resenyas_recientes is empty %}
                        <p class="text-secondary fst-italic p-3 mb-0">Sin valoraciones aún.</p>
                    {% else %}
                        <table class="table table-dark table-sm align-middle mb-0">
                            <thead style="position: sticky; top: 0; background-color: #1a1a1a;">
                                <tr class="border-secondary" style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; color: rgba(255,255,255,0.4);">
                                    <th class="ps-3">Usuario</th>
                                    <th>Carta</th>
                                    <th class="text-center">Nota</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for resenya in resenyas_recientes %}
                                    <tr>
                                        <td class="ps-3 text-white" style="font-size: 0.85rem;">{{ resenya.usuario.username }}</td>
                                        <td>
                                            <a href="{{ path('app_carta_detalle', {'id': resenya.carta.id}) }}" class="text-secondary text-decoration-none" style="font-size: 0.8rem;" title="{{ resenya.carta.nombre }}">
                                                {{ resenya.carta.nombre|slice(0, 20) }}{% if resenya.carta.nombre|length > 20 %}…{% endif %}
                                            </a>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-warning text-dark">★ {{ resenya.puntuacion }}</span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>

    {# SECCIÓN: Acciones Rápidas #}
    <h4 class="text-secondary text-uppercase mb-3" style="font-size: 0.8rem; letter-spacing: 2px;">Acciones Rápidas</h4>
    <div class="row g-3">

        <div class="col-md-6 col-lg-3">
            <a href="{{ path('admin_cartas_list') }}" class="card bg-dark border-secondary text-decoration-none h-100 p-4 d-flex flex-column align-items-start hover-gold">
                <span class="fs-2 mb-2">🃏</span>
                <h5 class="text-white fw-bold mb-1">Gestión de Cartas</h5>
                <p class="text-secondary small mb-0">Crear, editar y eliminar cartas del catálogo.</p>
            </a>
        </div>

        <div class="col-md-6 col-lg-3">
            <a href="{{ path('admin_expansiones') }}" class="card bg-dark border-secondary text-decoration-none h-100 p-4 d-flex flex-column align-items-start">
                <span class="fs-2 mb-2">📦</span>
                <h5 class="text-white fw-bold mb-1">Gestión de Expansiones</h5>
                <p class="text-secondary small mb-0">Crear, editar y eliminar categorías/expansiones.</p>
            </a>
        </div>

        <div class="col-md-6 col-lg-3">
            <a href="{{ path('admin_rankings') }}" class="card bg-dark border-secondary text-decoration-none h-100 p-4 d-flex flex-column align-items-start">
                <span class="fs-2 mb-2">🏆</span>
                <h5 class="text-white fw-bold mb-1">Gestión de Rankings</h5>
                <p class="text-secondary small mb-0">Crear tierlists globales y asignar cartas.</p>
            </a>
        </div>

        <div class="col-md-6 col-lg-3">
            <a href="{{ path('data_load_api') }}" class="card bg-dark border-warning text-decoration-none h-100 p-4 d-flex flex-column align-items-start" onclick="return confirm('¿Iniciar carga de cartas desde la API? Este proceso puede tardar varios minutos.')">
                <span class="fs-2 mb-2">📥</span>
                <h5 class="text-warning fw-bold mb-1">Cargar desde API</h5>
                <p class="text-secondary small mb-0">Importar/actualizar cartas desde apitcg.com.</p>
            </a>
        </div>

    </div>

</div>
{% endblock %}
