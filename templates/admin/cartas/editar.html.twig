{% extends 'base.html.twig' %}

{% block title %}Editar Carta - {{ carta.nombre }}{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 800px;">

    {# SECCIÓN: Cabecera #}
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
        <div>
            <h1 class="h3 fw-bold text-warning mb-0">✎ Editar Carta</h1>
            <small class="text-secondary font-monospace">{{ carta.id }}</small>
        </div>
        <a href="{{ path('admin_cartas_list') }}" class="btn btn-outline-light btn-sm">🔙 Volver</a>
    </div>

    {# SECCIÓN: Formulario #}
    <div class="card bg-dark border-secondary">
        <div class="card-body p-4">
            <form method="POST" action="{{ path('admin_carta_editar', {'id': carta.id}) }}">

                <div class="row g-3">

                    {# ID (readonly) y Nombre #}
                    <div class="col-md-4">
                        <label class="form-label text-muted small text-uppercase">ID (no editable)</label>
                        <input type="text" class="form-control bg-dark text-secondary border-secondary font-monospace"
                               value="{{ carta.id }}" disabled>
                    </div>
                    <div class="col-md-8">
                        <label for="nombre" class="form-label text-light">Nombre <span class="text-danger">*</span></label>
                        <input type="text" name="nombre" id="nombre" required
                               class="form-control bg-dark text-light border-secondary"
                               value="{{ carta.nombre }}">
                    </div>

                    {# Tipo y Color #}
                    <div class="col-md-4">
                        <label for="tipo" class="form-label text-light">Tipo <span class="text-danger">*</span></label>
                        <input type="text" name="tipo" id="tipo" required
                               class="form-control bg-dark text-light border-secondary"
                               value="{{ carta.tipo }}">
                    </div>
                    <div class="col-md-4">
                        <label for="color" class="form-label text-light">Color</label>
                        <input type="text" name="color" id="color"
                               class="form-control bg-dark text-light border-secondary"
                               value="{{ carta.color ?? '' }}">
                    </div>
                    <div class="col-md-4">
                        <label for="rarity" class="form-label text-light">Rareza</label>
                        <select name="rarity" id="rarity" class="form-select bg-dark text-light border-secondary">
                            <option value="">— Sin especificar —</option>
                            {% for r in ['Common', 'Uncommon', 'Rare', 'Super Rare', 'Secret Rare', 'Leader'] %}
                                <option value="{{ r }}" {% if carta.rarity == r %}selected{% endif %}>{{ r }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    {# Stats #}
                    <div class="col-md-4">
                        <label for="coste" class="form-label text-light">Coste</label>
                        <input type="number" name="coste" id="coste" min="0"
                               class="form-control bg-dark text-light border-secondary"
                               value="{{ carta.coste ?? '' }}">
                    </div>
                    <div class="col-md-4">
                        <label for="poder" class="form-label text-light">Poder</label>
                        <input type="number" name="poder" id="poder" min="0"
                               class="form-control bg-dark text-light border-secondary"
                               value="{{ carta.poder ?? '' }}">
                    </div>
                    <div class="col-md-4">
                        <label for="counter" class="form-label text-light">Counter</label>
                        <input type="number" name="counter" id="counter" min="0"
                               class="form-control bg-dark text-light border-secondary"
                               value="{{ carta.counter ?? '' }}">
                    </div>

                    {# Expansión y Atributo #}
                    <div class="col-md-6">
                        <label for="expansion" class="form-label text-light">Expansión</label>
                        <select name="expansion" id="expansion" class="form-select bg-dark text-light border-secondary">
                            <option value="">— Sin expansión —</option>
                            {% for expansion in expansiones %}
                                <option value="{{ expansion.id }}" {% if carta.expansion and carta.expansion.id == expansion.id %}selected{% endif %}>
                                    {{ expansion.nombreExpansion }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="atributoNombre" class="form-label text-light">Atributo</label>
                        <input type="text" name="atributoNombre" id="atributoNombre"
                               class="form-control bg-dark text-light border-secondary"
                               value="{{ carta.atributoNombre ?? '' }}">
                    </div>

                    {# Familia #}
                    <div class="col-12">
                        <label for="familia" class="form-label text-light">Familia</label>
                        <input type="text" name="familia" id="familia"
                               class="form-control bg-dark text-light border-secondary"
                               value="{{ carta.familia ?? '' }}">
                    </div>

                    {# Habilidad y Trigger #}
                    <div class="col-12">
                        <label for="habilidad" class="form-label text-light">Habilidad / Efecto</label>
                        <textarea name="habilidad" id="habilidad" rows="3"
                                  class="form-control bg-dark text-light border-secondary">{{ carta.habilidad ?? '' }}</textarea>
                    </div>
                    <div class="col-12">
                        <label for="efectoTrigger" class="form-label text-light">Efecto Trigger</label>
                        <textarea name="efectoTrigger" id="efectoTrigger" rows="2"
                                  class="form-control bg-dark text-light border-secondary">{{ carta.efectoTrigger ?? '' }}</textarea>
                    </div>

                </div>

                <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top border-secondary">
                    <a href="{{ path('admin_cartas_list') }}" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-warning fw-bold text-dark px-4">💾 Guardar Cambios</button>
                </div>

            </form>
        </div>
    </div>

</div>
{% endblock %}
