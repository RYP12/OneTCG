{% extends 'base.html.twig' %}

{% block title %}Gestión de Cartas - Admin{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-5">

    {# SECCIÓN: Cabecera #}
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
        <div>
            <h1 class="h2 fw-bold text-warning mb-0">🃏 Gestión de Cartas</h1>
            <small class="text-secondary">{{ cartas|length }} cartas encontradas</small>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('admin_carta_nueva') }}" class="btn btn-warning btn-sm fw-bold text-dark">✚ Nueva Carta</a>
            <a href="{{ path('data_load_api') }}" class="btn btn-outline-warning btn-sm"
               onclick="return confirm('¿Iniciar carga desde la API? Puede tardar varios minutos.')">📥 Cargar API</a>
            <a href="{{ path('admin_site') }}" class="btn btn-outline-light btn-sm">🔙 Panel</a>
        </div>
    </div>

    {# SECCIÓN: Filtros #}
    <div class="mb-4">
        <form method="GET" action="{{ path('admin_cartas_list') }}" class="d-flex align-items-center gap-3 flex-wrap">
            <div class="input-group input-group-sm" style="max-width: 280px;">
                <input type="text" name="q" value="{{ busqueda }}"
                       class="form-control bg-dark text-white border-secondary"
                       placeholder="Buscar por nombre..." autocomplete="off">
                <button type="submit" class="btn btn-warning btn-sm text-dark fw-bold">🔍</button>
            </div>
            <select name="expansion" class="form-select form-select-sm bg-dark text-white border-secondary"
                    style="max-width: 320px;" onchange="this.form.submit()">
                <option value="">Todas las expansiones</option>
                {% for expansion in expansiones %}
                    <option value="{{ expansion.id }}" {% if expansionActiva == expansion.id %}selected{% endif %}>
                        {{ expansion.nombreExpansion }}
                    </option>
                {% endfor %}
            </select>
            {% if expansionActiva or busqueda %}
                <a href="{{ path('admin_cartas_list') }}" class="btn btn-sm btn-outline-secondary">✕ Limpiar</a>
            {% endif %}
        </form>
    </div>

    {# SECCIÓN: Tabla de Cartas #}
    {% if cartas is not empty %}
        <div class="table-responsive">
            <table class="table table-dark table-hover border-secondary align-middle" style="font-size: 0.875rem;">
                <thead>
                    <tr>
                        <th class="text-warning">ID</th>
                        <th class="text-warning">Nombre</th>
                        <th class="text-warning">Tipo</th>
                        <th class="text-warning">Color</th>
                        <th class="text-warning">Rareza</th>
                        <th class="text-warning">Expansión</th>
                        <th class="text-warning text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for carta in cartas %}
                        <tr>
                            <td class="text-secondary font-monospace" style="white-space: nowrap;">{{ carta.id }}</td>
                            <td class="fw-bold text-truncate" style="max-width: 200px;" title="{{ carta.nombre }}">{{ carta.nombre }}</td>
                            <td><span class="badge bg-secondary">{{ carta.tipo }}</span></td>
                            <td>{{ carta.color ?? '-' }}</td>
                            <td>{{ carta.rarity ?? '-' }}</td>
                            <td class="text-secondary" style="max-width: 160px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="{{ carta.expansion ? carta.expansion.nombreExpansion : '' }}">
                                {{ carta.expansion ? carta.expansion.nombreExpansion : '—' }}
                            </td>
                            <td class="text-end" style="white-space: nowrap;">
                                <a href="{{ path('app_carta_detalle', {'id': carta.id}) }}"
                                   class="btn btn-sm btn-outline-secondary me-1" target="_blank" title="Ver">👁</a>
                                <a href="{{ path('admin_carta_editar', {'id': carta.id}) }}"
                                   class="btn btn-sm btn-outline-info me-1">✎</a>
                                <a href="{{ path('admin_carta_eliminar', {'id': carta.id}) }}"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('¿Eliminar la carta «{{ carta.nombre }}»? Esta acción no se puede deshacer.')">🗑</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-dark border-secondary text-center text-light py-5">
            <p class="mb-2">No se encontraron cartas.</p>
            {% if busqueda or expansionActiva %}
                <a href="{{ path('admin_cartas_list') }}" class="btn btn-outline-secondary btn-sm">Ver todas</a>
            {% else %}
                <a href="{{ path('data_load_api') }}" class="btn btn-warning btn-sm text-dark fw-bold">📥 Cargar desde API</a>
            {% endif %}
        </div>
    {% endif %}

</div>
{% endblock %}
