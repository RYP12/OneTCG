{% extends 'base.html.twig' %}

{% block title %}Gestión de Expansiones - Admin{% endblock %}

{% block body %}
<div class="container py-5">

    {# SECCIÓN: Cabecera #}
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
        <div>
            <h1 class="display-5 fw-bold text-warning mb-0">📦 Gestión de Expansiones</h1>
            <small class="text-secondary">{{ expansiones|length }} expansiones registradas</small>
        </div>
        <a href="{{ path('admin_site') }}" class="btn btn-outline-light btn-sm">🔙 Panel Admin</a>
    </div>

    {# SECCIÓN: Formulario Crear Expansión #}
    <div class="card bg-dark border-secondary mb-5">
        <div class="card-body">
            <h5 class="text-light mb-3">Nueva Expansión</h5>
            <form method="POST" action="{{ path('admin_expansiones') }}" class="d-flex gap-3 align-items-end">
                <div class="flex-grow-1">
                    <label for="nombre" class="form-label text-muted small text-uppercase">Nombre de la expansión</label>
                    <input type="text" name="nombre" id="nombre"
                           class="form-control bg-dark text-light border-secondary"
                           placeholder="Ej: Romance Dawn, Paramount War..." required>
                </div>
                <button type="submit" class="btn btn-warning fw-bold text-dark px-4">
                    ✚ Crear
                </button>
            </form>
        </div>
    </div>

    {# SECCIÓN: Tabla de Expansiones #}
    {% if expansiones is not empty %}
        <div class="table-responsive">
            <table class="table table-dark table-hover border-secondary align-middle">
                <thead>
                    <tr>
                        <th class="text-warning">#</th>
                        <th class="text-warning">Nombre de la Expansión</th>
                        <th class="text-warning text-center">Cartas</th>
                        <th class="text-warning text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in expansiones %}
                        <tr>
                            <td class="text-secondary">{{ row.expansion.id }}</td>
                            <td class="fw-bold">{{ row.expansion.nombreExpansion }}</td>
                            <td class="text-center">
                                <span class="badge bg-secondary">{{ row.num_cartas }}</span>
                            </td>
                            <td class="text-end">
                                <a href="{{ path('admin_expansion_editar', {'id': row.expansion.id}) }}"
                                   class="btn btn-sm btn-outline-info me-2">✎ Editar</a>
                                <a href="{{ path('admin_expansion_eliminar', {'id': row.expansion.id}) }}"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('¿Eliminar «{{ row.expansion.nombreExpansion }}»? Las cartas de esta expansión quedarán sin categoría.')">
                                    🗑 Eliminar
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-dark border-secondary text-center text-light">
            No hay expansiones registradas. Créalas manualmente o carga las cartas desde la API.
        </div>
    {% endif %}

</div>
{% endblock %}
