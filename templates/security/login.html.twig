{% extends 'base.html.twig' %}

{% block title %}Iniciar Sesión - OneTCG
{% endblock %}

{% block body %}
	<div class="auth-wrapper">
		<div class="auth-card">

			<div class="auth-header">
				<span class="auth-icon">☠️</span>
				<h1>Iniciar Sesión</h1>
			</div>

			{% if error %}
				<div class="auth-alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
			{% endif %}

			{% if app.user %}
				<div class="auth-logged">
					Sesión activa como
					<strong>{{ app.user.userIdentifier }}</strong>
					&mdash;
					<a href="{{ logout_path() }}">Cerrar sesión</a>
				</div>
			{% endif %}

			<form method="post">
				<div class="auth-group">
					<label for="username">Nombre de usuario</label>
					<div class="auth-input-wrap">
						<input type="text" id="username" name="_username" class="auth-input" value="{{ last_username }}" autocomplete="username" placeholder="Ej. LuffyReyPirata" required autofocus>
						<span class="auth-input-icon">🧑‍✈️</span>
					</div>
				</div>

				<div class="auth-group">
					<label for="password">Contraseña</label>
					<div class="auth-input-wrap">
						<input type="password" id="password" name="_password" class="auth-input" autocomplete="current-password" placeholder="••••••••" required>
						<span class="auth-input-icon">🔒</span>
					</div>
				</div>

				<input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

				<button class="auth-btn" type="submit">Entrar</button>
			</form>

			<div class="auth-footer">
				¿No tienes una cuenta?
				<a href="{{ path('app_register') }}">Regístrate aquí</a>
			</div>

		</div>
	</div>
{% endblock %}
