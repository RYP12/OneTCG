{# SECCIÓN: Base Layout #}
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}One Piece TCG
			{% endblock %}
		</title>
		<link
		rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🏴‍☠️</text></svg>">

		{# SECCIÓN: Fuentes y Estilos #}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">

		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

		<style>:root
		{
			--op-gold: #f1c40f;
			--op-red: #e74c3c;
		}
		body {
			font-family: 'Roboto', sans-serif;
			background-color: #121212;
			color: #e0e0e0;
		}
		h1,
		h2,
		h3,
		h4,
		.navbar-brand,
		.btn {
			font-family: 'Rajdhani', sans-serif;
			text-transform: uppercase;
			letter-spacing: 1px;
		}
		.navbar-glass {
			background: rgba(20, 20, 20, 0.95);
			backdrop-filter: blur(10px);
			border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		}
		.dropdown-menu-dark {
			background-color: #1e1e1e;
			border: 1px solid rgba(255, 255, 255, 0.1);
		}
		.dropdown-item:hover {
			background-color: var(--op-gold);
			color: #000 !important;
		}
		.admin-header {
			font-size: 0.75rem;
			letter-spacing: 1px;
			text-transform: uppercase;
		}

		/* SECCIÓN: Páginas de Autenticación */
		@keyframes auth-gradient {
			0% {
				background-position: 0 50%;
			}
			50% {
				background-position: 100% 50%;
			}
			100% {
				background-position: 0 50%;
			}
		}
		.auth-wrapper {
			min-height: 100vh;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 2rem 1rem;
			background: linear-gradient(135deg, #0d0d0d 0%, #1a1005 25%, #0d0d0d 50%, #0a0a1a 75%, #0d0d0d 100%);
			background-size: 400% 400%;
			animation: auth-gradient 15s ease infinite;
		}
		.auth-card {
			width: 100%;
			max-width: 440px;
			background: rgba(255, 255, 255, 0.04);
			backdrop-filter: blur(24px);
			-webkit-backdrop-filter: blur(24px);
			border: 1px solid rgba(255, 255, 255, 0.08);
			border-radius: 20px;
			padding: 2.5rem 2rem;
			box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.05);
		}
		.auth-header {
			text-align: center;
			margin-bottom: 2rem;
		}
		.auth-header .auth-icon {
			font-size: 3rem;
			display: block;
			margin-bottom: 0.5rem;
			filter: drop-shadow(0 0 12px rgba(241, 196, 15, 0.4));
		}
		.auth-header h1 {
			font-family: 'Rajdhani', sans-serif;
			font-weight: 700;
			font-size: 1.75rem;
			color: var(--op-gold);
			text-transform: uppercase;
			letter-spacing: 2px;
			margin: 0;
		}
		.auth-group {
			position: relative;
			margin-bottom: 1.25rem;
		}
		.auth-group label {
			display: block;
			font-size: 0.8rem;
			font-weight: 500;
			color: rgba(255, 255, 255, 0.5);
			text-transform: uppercase;
			letter-spacing: 1px;
			margin-bottom: 0.4rem;
		}
		.auth-group .auth-input-wrap {
			position: relative;
		}
		.auth-group .auth-input-icon {
			position: absolute;
			left: 14px;
			top: 50%;
			transform: translateY(-50%);
			font-size: 1.1rem;
			opacity: 0.5;
			pointer-events: none;
			transition: opacity 0.3s;
		}
		.auth-input {
			width: 100%;
			background: rgba(255, 255, 255, 0.06);
			border: 1px solid rgba(255, 255, 255, 0.1);
			border-radius: 12px;
			padding: 0.75rem 0.75rem 0.75rem 2.75rem;
			color: #e0e0e0;
			font-size: 0.95rem;
			transition: border-color 0.3s, box-shadow 0.3s, background 0.3s;
			outline: none;
		}
		.auth-input::placeholder {
			color: rgba(255, 255, 255, 0.25);
		}
		.auth-input:focus {
			border-color: var(--op-gold);
			box-shadow: 0 0 0 3px rgba(241, 196, 15, 0.15);
			background: rgba(255, 255, 255, 0.08);
		}
		.auth-input:focus + .auth-input-icon {
			opacity: 1;
		}
		.auth-hint {
			font-size: 0.78rem;
			color: rgba(255, 255, 255, 0.35);
			margin-top: 0.35rem;
		}
		.auth-btn {
			width: 100%;
			padding: 0.85rem;
			margin-top: 1.5rem;
			border: none;
			border-radius: 12px;
			background: linear-gradient(135deg, var(--op-gold) 0%, #e67e22 100%);
			color: #111;
			font-family: 'Rajdhani', sans-serif;
			font-weight: 700;
			font-size: 1.1rem;
			text-transform: uppercase;
			letter-spacing: 2px;
			cursor: pointer;
			transition: transform 0.2s, box-shadow 0.2s;
			box-shadow: 0 4px 15px rgba(241, 196, 15, 0.25);
		}
		.auth-btn:hover {
			transform: translateY(-2px);
			box-shadow: 0 6px 25px rgba(241, 196, 15, 0.4);
		}
		.auth-btn:active {
			transform: translateY(0);
		}
		.auth-footer {
			text-align: center;
			margin-top: 1.75rem;
			padding-top: 1.25rem;
			border-top: 1px solid rgba(255, 255, 255, 0.06);
			font-size: 0.88rem;
			color: rgba(255, 255, 255, 0.45);
		}
		.auth-footer a {
			color: var(--op-gold);
			text-decoration: none;
			font-weight: 600;
			transition: color 0.2s, text-shadow 0.2s;
		}
		.auth-footer a:hover {
			color: #f9d923;
			text-shadow: 0 0 8px rgba(241, 196, 15, 0.4);
		}
		.auth-alert {
			background: rgba(231, 76, 60, 0.15);
			border: 1px solid rgba(231, 76, 60, 0.3);
			border-radius: 10px;
			padding: 0.75rem 1rem;
			color: #e74c3c;
			font-size: 0.88rem;
			margin-bottom: 1.25rem;
		}
		.auth-logged {
			background: rgba(241, 196, 15, 0.08);
			border: 1px solid rgba(241, 196, 15, 0.2);
			border-radius: 10px;
			padding: 0.75rem 1rem;
			font-size: 0.88rem;
			color: rgba(255, 255, 255, 0.7);
			margin-bottom: 1.25rem;
			text-align: center;
		}
		.auth-logged a {
			color: var(--op-gold);
			font-weight: 600;
			text-decoration: none;
		}
	</style>
	{% block stylesheets %}{% endblock %}
</head>
<body>

	{# SECCIÓN: Navbar #}
	<nav class="navbar navbar-expand-lg navbar-dark navbar-glass sticky-top mb-0">
		<div class="container">
			<a class="navbar-brand fw-bold text-warning" href="{{ path('app_home') }}">
				☠️ One Piece TCG
			</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
				<span class="navbar-toggler-icon"></span>
			</button>

			<div class="collapse navbar-collapse" id="menuPrincipal">
				<ul class="navbar-nav me-auto mb-2 mb-lg-0">
					<li class="nav-item">
						<a class="nav-link active" href="{{ path('app_directorio') }}">Directorio</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="{{ path('app_mis_rankings') }}">Ranking</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="{{ path('app_estadisticas') }}">Estadísticas Globales</a>
					</li>
				</ul>

				<div class="d-flex align-items-center gap-2">

					{% if app.user %}

						<div class="dropdown">
							<a class="btn btn-outline-warning dropdown-toggle border-0" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
								{% if is_granted('ROLE_ADMIN') %}👨‍💻{% else %}🧑‍✈️
								{% endif %}
								{{ app.user.userIdentifier }}
							</a>

							<ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
								<li>
									<h6 class="dropdown-header text-secondary">Mi Cuenta</h6>
								</li>
								<li>
									<a class="dropdown-item" href="{{ path('app_mis_rankings') }}">Mis Rankings</a>
								</li>

								{% if is_granted('ROLE_ADMIN') %}
									<li><hr class="dropdown-divider border-secondary"></li>
									<li>
										<h6 class="dropdown-header text-warning admin-header">Panel Admin</h6>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('admin_site') }}">🖥️ Dashboard Admin</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('admin_cartas_list') }}">🃏 Gestión de Cartas</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('admin_expansiones') }}">📦 Gestión de Expansiones</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('admin_rankings') }}">🏆 Gestión de Rankings</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('data_load_api') }}" onclick="return confirm('¿Iniciar carga desde la API?')">📥 Cargar Cartas (API)</a>
									</li>
								{% endif %}

								<li><hr class="dropdown-divider border-secondary"></li>
								<li>
									<a class="dropdown-item text-danger fw-bold" href="{{ path('app_logout') }}">
										Cerrar Sesión
									</a>
								</li>
							</ul>
						</div>

					{% else %}
						<a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm px-3">Entrar</a>
						<a href="{{ path('app_register') }}" class="btn btn-warning btn-sm text-dark fw-bold px-3">Unirse</a>
					{% endif %}

				</div>
			</div>
		</div>
	</nav>

	{% block body %}{% endblock %}

	{# SECCIÓN: Footer #}
	<footer class="text-center text-secondary py-5 mt-5 border-top border-secondary">
		<small>Hecho con Symfony & Bootstrap | Fan Site no oficial</small>
	</footer>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
